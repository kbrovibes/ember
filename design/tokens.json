{
  "meta": { "name": "Ember", "platform": "macOS 14+ / SwiftUI", "recommended": "Tape + rolling numerals", "units": "pt unless noted" },
  "color": {
    "focus":      { "light": "#CC4317", "dark": "#FF8A5B", "softLight": "#FCEDE6", "softDark": "#2B1710" },
    "shortBreak": { "light": "#2C7A8C", "dark": "#6CC4D6", "softLight": "#E4F1F4", "softDark": "#10252A" },
    "longBreak":  { "light": "#5A5FB8", "dark": "#9EA3F0", "softLight": "#ECEDF9", "softDark": "#1A1B33" },
    "onAccent":   { "light": "#FFFFFF", "dark": "#1A0D07" },
    "bg":         { "light": "#FAFAFA", "dark": "#0E0E10" },
    "surface":    { "light": "#FFFFFF", "dark": "#17171A" },
    "surface2":   { "light": "#F4F4F5", "dark": "#1F1F23" },
    "line":       { "light": "#E4E4E7", "dark": "#2A2A2F" },
    "line2":      { "light": "#D4D4D8", "dark": "#3A3A41" },
    "ink":        { "light": "#18181B", "dark": "#F4F4F5" },
    "ink2":       { "light": "#52525B", "dark": "#A1A1AA" },
    "ink3":       { "light": "#676773", "dark": "#9A9AA5" }
  },
  "modeIdentity": {
    "focus":      { "label": "Focus",       "symbol": "flame",  "segment": "tall, solid" },
    "shortBreak": { "label": "Short break", "symbol": "cup",    "segment": "short, tinted" },
    "longBreak":  { "label": "Long break",  "symbol": "moon",   "segment": "last of cycle" },
    "rule": "Never colour alone: label + SF Symbol + segment position always accompany accent."
  },
  "radius": { "chip": 6, "button": 10, "card": 14, "popover": 14, "window": 12, "pill": 999 },
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32, "xxxl": 48 },
  "type": {
    "text": "SF Pro Text",
    "display": "SF Pro Display (headings: Avenir Next / SF Pro Rounded optional)",
    "digits": "monospacedDigit(), weight .light for large, .semibold below 32",
    "scale": {
      "caption": { "size": 11, "weight": "medium" },
      "footnote": { "size": 12, "weight": "regular" },
      "body": { "size": 13, "weight": "regular" },
      "subhead": { "size": 15, "weight": "semibold" },
      "title": { "size": 22, "weight": "semibold" },
      "timePopover": { "size": 58, "weight": "light" },
      "timeWindow": { "size": 112, "weight": "ultraLight" },
      "timeFullscreen": { "size": 240, "weight": "ultraLight" }
    }
  },
  "motion": {
    "duration": { "micro": 0.12, "fast": 0.18, "base": 0.28, "slow": 0.48, "colorShift": 0.7, "digitRoll": 0.7 },
    "easing": {
      "standard": [0.22, 1, 0.36, 1],
      "emphasized": [0.34, 1.45, 0.64, 1],
      "exit": [0.4, 0, 1, 1]
    },
    "spring": { "stiffness": 260, "damping": 26, "mass": 1, "swiftUI": "spring(response: 0.39, dampingFraction: 0.81)", "use": "drag-to-set follow, press, thumbs" },
    "enter": { "scaleFrom": 0.985, "offsetY": 6, "stagger": 0.04 },
    "exitRatio": 0.65,
    "reducedMotion": "no spring, no waves/sparks, crossfade 0.12s, digits cut"
  },
  "interaction": {
    "dragToSet": {
      "detentMinutes": 5, "fineMinutes": 1, "fineModifier": "shift",
      "range": { "focus": [1, 90], "short": [1, 30], "long": [5, 60], "rounds": [2, 8] },
      "tape": { "pointsPerMinute": 10, "inertiaProjectionMs": 220, "snap": "nearest minute via spring" },
      "ring": { "degreesPerMinute": 6, "relativeAfterGrab": true },
      "mono": { "pointsPerMinutePopover": 6, "pointsPerMinuteWindow": 8, "direction": "down adds time" },
      "tickFeedback": "NSHapticFeedbackManager .alignment per detent + 1.018 scale pulse 0.24s",
      "dragThresholdPoints": 3
    }
  },
  "window": {
    "popover": { "w": 320, "h": "420 running / 500 idle (auto)", "menuBarOffset": 6 },
    "main": { "w": 840, "h": 540, "min": [640, 420] },
    "fullscreen": "screen bounds, controls fade to 0.22 opacity after 2s without pointer",
    "scenarioEditor": { "w": 840, "h": 540 },
    "stats": { "w": 640, "h": 470 },
    "settings": { "w": 560, "h": 520 },
    "menuBarItem": { "h": 24, "glyph": 14, "textStyle": "13 medium monospacedDigit" }
  }
}
